@startuml database
title Авито.Кухня — схема данных
hide methods
hide stereotypes
skinparam linetype ortho

entity establishments {
  * id : uuid <<PK>>
  --
  external_id : text <<UK>>
  name : text
  description : text
  currency : char(3)
  is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity menu_items {
  * id : uuid <<PK>>
  --
  establishment_id : uuid <<FK>>
  external_id : text
  name : text
  description : text
  price_minor : bigint
  is_available : boolean
}

entity orders {
  * id : uuid <<PK>>
  --
  customer_id : uuid
  establishment_id : uuid <<FK>>
  status : text
  currency : char(3)
  total_minor : bigint
  delivery_address : text
  external_id : text
}

entity order_items {
  * order_id : uuid <<PK, FK>>
  * menu_item_id : uuid <<PK, FK>>
  --
  establishment_id : uuid <<FK>>
  name : text
  price_minor : bigint
  quantity : integer
}

entity order_status_history {
  * id : bigint <<PK>>
  --
  order_id : uuid <<FK>>
  from_status : text
  to_status : text
  actor : text
  created_at : timestamptz
}

entity idempotency_keys {
  * scope : text <<PK>>
  * key : text <<PK>>
  --
  request_hash : char(64)
  resource_id : uuid
  created_at : timestamptz
}

establishments ||--o{ menu_items
establishments ||--o{ orders
orders ||--|{ order_items
menu_items ||--o{ order_items
orders ||--o{ order_status_history

note right of order_items
  Название и цена являются снимком:
  изменения меню не меняют историю заказа.
  Составные внешние ключи гарантируют,
  что заказ и блюдо принадлежат одному заведению.
end note
@enduml
