{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "Машиночитаемое описание ошибки.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единая оболочка ошибочного HTTP-ответа.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Ответ проверки процесса сервиса заведения.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Order": {
        "description": "Заказ, полученный от платформы.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "delivery_address": {
            "title": "Delivery Address",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "title": "Items",
            "type": "array"
          },
          "restaurant_id": {
            "format": "uuid",
            "title": "Restaurant Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total_minor": {
            "title": "Total Minor",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer_id",
          "restaurant_id",
          "status",
          "currency",
          "total_minor",
          "delivery_address",
          "items",
          "created_at",
          "updated_at"
        ],
        "title": "Order",
        "type": "object"
      },
      "OrderItem": {
        "description": "Зафиксированная позиция заказа.",
        "properties": {
          "menu_item_id": {
            "format": "uuid",
            "title": "Menu Item Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_minor": {
            "title": "Price Minor",
            "type": "integer"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "menu_item_id",
          "name",
          "price_minor",
          "quantity"
        ],
        "title": "OrderItem",
        "type": "object"
      },
      "OrderList": {
        "description": "Очередь заказов заведения.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "OrderList",
        "type": "object"
      },
      "OrderStatus": {
        "description": "Статусы заказа, видимые заведению.",
        "enum": [
          "created",
          "accepted",
          "rejected",
          "preparing",
          "ready",
          "delivering",
          "completed",
          "cancelled"
