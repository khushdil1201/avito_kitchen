            "description": "Ошибка валидации запроса"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Внутренняя ошибка сервиса"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Сервис временно недоступен"
          }
        },
        "summary": "Проверить состояние процесса",
        "tags": [
          "Состояние сервиса"
        ]
      }
    },
