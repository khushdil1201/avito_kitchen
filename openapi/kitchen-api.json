{
  "components": {
    "schemas": {
      "CreateOrderItemRequest": {
        "description": "Блюдо и требуемое количество.",
        "properties": {
          "menu_item_id": {
            "format": "uuid",
            "title": "Menu Item Id",
            "type": "string"
          },
          "quantity": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "menu_item_id",
          "quantity"
        ],
        "title": "CreateOrderItemRequest",
        "type": "object"
      },
      "CreateOrderRequest": {
        "description": "Данные для оформления заказа.",
        "properties": {
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "delivery_address": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Delivery Address",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemRequest"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "restaurant_id": {
            "format": "uuid",
            "title": "Restaurant Id",
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "restaurant_id",
          "delivery_address",
          "items"
        ],
        "title": "CreateOrderRequest",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Машиночитаемое описание ошибки.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единая оболочка ошибочного HTTP-ответа.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Ответ проверки состояния процесса приложения.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MenuItemResponse": {
        "description": "Позиция меню; цена указана в минимальных единицах валюты.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_available": {
            "title": "Is Available",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_minor": {
            "exclusiveMinimum": 0.0,
            "title": "Price Minor",
            "type": "integer"
          },
          "restaurant_id": {
            "format": "uuid",
            "title": "Restaurant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "restaurant_id",
          "name",
          "description",
          "price_minor",
          "is_available"
        ],
        "title": "MenuItemResponse",
        "type": "object"
      },
      "MenuResponse": {
        "description": "Страница меню заведения.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MenuItemResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationResponse"
          }
        },
        "required": [
          "items",
          "pagination"
        ],
        "title": "MenuResponse",
        "type": "object"
      },
      "OrderItemResponse": {
        "description": "Снимок блюда в оформленном заказе.",
        "properties": {
          "menu_item_id": {
            "format": "uuid",
            "title": "Menu Item Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_minor": {
            "title": "Price Minor",
            "type": "integer"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "menu_item_id",
          "name",
          "price_minor",
          "quantity"
        ],
        "title": "OrderItemResponse",
        "type": "object"
      },
      "OrderResponse": {
        "description": "Заказ и зафиксированные позиции.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "delivery_address": {
            "title": "Delivery Address",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "restaurant_id": {
            "format": "uuid",
            "title": "Restaurant Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total_minor": {
            "title": "Total Minor",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer_id",
          "restaurant_id",
          "status",
          "currency",
          "total_minor",
          "delivery_address",
          "items",
          "created_at",
          "updated_at"
        ],
        "title": "OrderResponse",
        "type": "object"
      },
      "OrderStatus": {
        "description": "Состояние заказа, которым владеет платформа.",
        "enum": [
          "created",
          "accepted",
          "rejected",
          "preparing",
          "ready",
          "delivering",
          "completed",
          "cancelled"
        ],
        "title": "OrderStatus",
        "type": "string"
      },
      "PaginationResponse": {
        "description": "Метаданные offset-пагинации.",
        "properties": {
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "limit",
          "offset",
          "total"
        ],
        "title": "PaginationResponse",
        "type": "object"
      },
      "PartnerOrderListResponse": {
        "description": "Ограниченная очередь заказов заведения.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "PartnerOrderListResponse",
        "type": "object"
      },
      "PartnerTargetStatus": {
        "description": "Статусы, которые разрешено устанавливать заведению.",
        "enum": [
          "accepted",
          "rejected",
          "preparing",
          "ready"
        ],
        "title": "PartnerTargetStatus",
        "type": "string"
      },
      "RestaurantListResponse": {
        "description": "Страница доступных заведений.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RestaurantResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationResponse"
          }
        },
        "required": [
          "items",
          "pagination"
        ],
        "title": "RestaurantListResponse",
        "type": "object"
      },
      "RestaurantResponse": {
        "description": "Заведение в пользовательском каталоге.",
        "properties": {
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "currency"
        ],
        "title": "RestaurantResponse",
        "type": "object"
      },
      "TransitionOrderRequest": {
        "description": "Команда изменения состояния заказа заведением.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/PartnerTargetStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "TransitionOrderRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "API платформы для заказа еды",
    "title": "Авито.Кухня API",
